{
  "name": "reser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "test:unit": "vp run website#test:unit && vp run utils#test",
    "test:integration": "vp run website#test:integration",
    "coverage:domain": "vp run website#coverage:domain",
    "coverage:calendar": "vp run website#coverage:calendar",
    "regression": "vp run ready && vp run e2e && vp run smoke:preview",
    "e2e": "vp run website#e2e",
    "e2e:install": "vp run website#e2e:install",
    "smoke": "vp run website#smoke",
    "smoke:preview": "vp run website#smoke:preview",
    "dev": "vp run website#dev",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
