NODE_ENV=production
MVP_MODE=production
PORT=3001
DATABASE_PATH=/var/lib/bowling/production.sqlite
TOKEN_SECRET=replace-with-a-stable-random-secret-of-at-least-32-bytes
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=replace-with-a-password-of-at-least-12-characters
PUBLIC_APP_URL=https://reservas.your-domain.example
MAIL_DELIVERY_URL=https://mail-adapter.your-domain.example/send
MAIL_DELIVERY_TOKEN=replace-with-the-mail-adapter-token
MAIL_FROM=reservas@your-domain.example
